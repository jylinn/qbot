# 複製成 .env 後修改。.env 只放在你自己的主機上，不要上傳、不要貼給任何人。
# 檔案權限建議：chmod 600 .env

# 模式：paper（紙上交易，不需金鑰）／testnet（幣安模擬盤）／live（實盤）
MODE=paper

# 幣安 API 金鑰（paper 模式留空）。只開需要的權限，絕對不要開「提現」，並綁定主機 IP。
BINANCE_KEY=
BINANCE_SECRET=

# 紙上交易的起始資金（USDT）
PAPER_EQUITY=1000
# 紙上交易手續費（吃單），幣安一般用戶 USDⓈ-M 為 0.0005
PAPER_TAKER_FEE=0.0005
# 紙上交易每幾秒用即時價格檢查一次停損
WATCH_SECONDS=3

# 槓桿只影響保證金占用，實際曝險由策略決定
BTC_LEVERAGE=10
ALT_LEVERAGE=5

# 閒置資金放貸：1 開／0 關
LEND=1
LEND_IN_POSITION=0
MIN_FUTURES_FRAC=0.3
PAPER_LEND_APY=0.03

# 山寨幣模組（示範策略不交易山寨幣）、波動縮放：1 開／0 關
ALTS=0
GARCH=1

# 首次啟動：flat（從空手開始）／follow（回放最近 FOLLOW_DAYS 天，直接跟上目前部位）
START_MODE=flat
FOLLOW_DAYS=60

DELAY_SECONDS=20
MAX_GROSS=8
